<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org">

  <!-- 6축 F/T 센서 매크로 (Isaac Sim에서 Force Sensor 부착 기준점) -->
  <xacro:macro name="ft_sensor_module" params="prefix parent">
    <joint name="${prefix}_ft_sensor_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_ft_sensor_link"/>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}_ft_sensor_link">
      <visual>
        <geometry><cylinder radius="0.032" length="0.02"/></geometry>
        <material name="orange"><color rgba="0.9 0.4 0.0 1.0"/></material>
      </visual>
      <collision><geometry><cylinder radius="0.032" length="0.02"/></geometry></collision>
      <inertial>
        <mass value="0.25"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- 왼팔 엔드이펙터: 고마찰 2지 평행 그리퍼 (냄비/프라이팬 파지용) -->
  <xacro:macro name="left_parallel_gripper" params="parent">
    <joint name="left_gripper_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="left_gripper_base"/>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>
    <link name="left_gripper_base">
      <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry><box size="0.07 0.11 0.05"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry><box size="0.07 0.11 0.05"/></geometry>
      </collision>
      <inertial>
        <mass value="0.6"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Left Finger -->
    <joint name="left_finger_joint_1" type="prismatic">
      <parent link="left_gripper_base"/>
      <child link="left_finger_1"/>
      <origin xyz="0 0.0425 0.05" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.0425" effort="235.0" velocity="0.1"/>
    </joint>
    <link name="left_finger_1">
      <visual>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <geometry><box size="0.025 0.012 0.09"/></geometry>
        <material name="silicone_blue"><color rgba="0.0 0.6 0.8 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <geometry><box size="0.025 0.012 0.09"/></geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Right Finger (Mimic Joint) -->
    <joint name="left_finger_joint_2" type="prismatic">
      <parent link="left_gripper_base"/>
      <child link="left_finger_2"/>
      <origin xyz="0 -0.0425 0.05" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.0425" effort="235.0" velocity="0.1"/>
      <mimic joint="left_finger_joint_1" multiplier="1.0" offset="0.0"/>
    </joint>
    <link name="left_finger_2">
      <visual>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <geometry><box size="0.025 0.012 0.09"/></geometry>
        <material name="silicone_blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <geometry><box size="0.025 0.012 0.09"/></geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- 오른팔 엔드이펙터: 전동 회전 방수 브러시/수세미 모듈 -->
  <xacro:macro name="right_scrubber_brush" params="parent">
    <joint name="right_brush_motor_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="right_brush_housing"/>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>
    <link name="right_brush_housing">
      <visual>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry><cylinder radius="0.03" length="0.06"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry><cylinder radius="0.03" length="0.06"/></geometry>
      </collision>
      <inertial>
        <mass value="0.45"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
      </inertial>
    </link>

    <!-- 연속 회전 브러시 패드 (Continuous Joint) -->
    <joint name="right_brush_spin_joint" type="continuous">
      <parent link="right_brush_housing"/>
      <child link="right_brush_pad"/>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>
    <link name="right_brush_pad">
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry><cylinder radius="0.045" length="0.04"/></geometry>
        <material name="sponge_yellow"><color rgba="0.95 0.85 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry><cylinder radius="0.045" length="0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
  </xacro:macro>

</robot>
