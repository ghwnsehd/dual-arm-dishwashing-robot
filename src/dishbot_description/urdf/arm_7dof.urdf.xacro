<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org">

  <material name="robot_white"><color rgba="0.92 0.93 0.95 1.0"/></material>
  <material name="joint_dark"><color rgba="0.18 0.20 0.22 1.0"/></material>
  <material name="waterproof_seal"><color rgba="0.95 0.38 0.05 1.0"/></material>
  <material name="anodized_blue"><color rgba="0.12 0.42 0.78 1.0"/></material>
  <material name="brushed_metal"><color rgba="0.72 0.75 0.78 1.0"/></material>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="seal_ring" params="r">
    <visual>
      <geometry><cylinder radius="${r}" length="0.008"/></geometry>
      <material name="waterproof_seal"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="arm_7dof" params="prefix parent reflect *origin">

    <!-- Base Flange -->
    <joint name="${prefix}_base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}_link_0"/>
    </joint>
    <link name="${prefix}_link_0">
      <visual><origin xyz="0 0 0.015"/><geometry><cylinder radius="0.082" length="0.03"/></geometry><material name="brushed_metal"/></visual>
      <visual><origin xyz="0 0 0.055"/><geometry><cylinder radius="0.068" length="0.05"/></geometry><material name="joint_dark"/></visual>
      <collision><origin xyz="0 0 0.04"/><geometry><cylinder radius="0.075" length="0.08"/></geometry></collision>
      <xacro:cylinder_inertia m="1.3" r="0.07" h="0.08"/>
    </link>

    <!-- Joint 1: Shoulder Yaw -->
    <joint name="${prefix}_joint_1" type="revolute">
      <parent link="${prefix}_link_0"/><child link="${prefix}_link_1"/>
      <origin xyz="0 0 0.08"/><axis xyz="0 0 1"/>
      <limit lower="-2.96" upper="2.96" effort="80.0" velocity="2.0"/>
    </joint>
    <link name="${prefix}_link_1">
      <xacro:seal_ring r="0.069"/>
      <visual><origin xyz="0 0 0.045"/><geometry><cylinder radius="0.064" length="0.09"/></geometry><material name="robot_white"/></visual>
      <visual><origin xyz="0 0 0.095" rpy="1.5708 0 0"/><geometry><cylinder radius="0.062" length="0.145"/></geometry><material name="joint_dark"/></visual>
      <collision><origin xyz="0 0 0.055"/><geometry><cylinder radius="0.068" length="0.11"/></geometry></collision>
      <xacro:cylinder_inertia m="1.4" r="0.065" h="0.11"/>
    </link>

    <!-- Joint 2: Shoulder Pitch -->
    <joint name="${prefix}_joint_2" type="revolute">
      <parent link="${prefix}_link_1"/><child link="${prefix}_link_2"/>
      <origin xyz="0 0 0.095"/><axis xyz="0 1 0"/>
      <limit lower="-2.09" upper="2.09" effort="80.0" velocity="2.0"/>
    </joint>
    <link name="${prefix}_link_2">
      <visual><origin xyz="0 0.074 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.058" length="0.008"/></geometry><material name="waterproof_seal"/></visual>
      <visual><origin xyz="0 -0.074 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.058" length="0.008"/></geometry><material name="waterproof_seal"/></visual>
      <visual><origin xyz="0 0 0.165"/><geometry><cylinder radius="0.052" length="0.26"/></geometry><material name="anodized_blue"/></visual>
      <visual><origin xyz="0 0 0.305"/><geometry><cylinder radius="0.055" length="0.04"/></geometry><material name="joint_dark"/></visual>
      <collision><origin xyz="0 0 0.165"/><geometry><cylinder radius="0.055" length="0.32"/></geometry></collision>
      <xacro:cylinder_inertia m="1.6" r="0.052" h="0.33"/>
    </link>

    <!-- Joint 3: Shoulder Roll -->
    <joint name="${prefix}_joint_3" type="revolute">
      <parent link="${prefix}_link_2"/><child link="${prefix}_link_3"/>
      <origin xyz="0 0 0.33"/><axis xyz="0 0 1"/>
      <limit lower="-2.96" upper="2.96" effort="40.0" velocity="2.5"/>
    </joint>
    <link name="${prefix}_link_3">
      <xacro:seal_ring r="0.056"/>
      <visual><origin xyz="0 ${reflect * 0.012} 0.035"/><geometry><cylinder radius="0.050" length="0.07"/></geometry><material name="robot_white"/></visual>
      <visual><origin xyz="0 ${reflect * 0.025} 0.075" rpy="1.5708 0 0"/><geometry><cylinder radius="0.048" length="0.115"/></geometry><material name="joint_dark"/></visual>
      <collision><origin xyz="0 ${reflect * 0.015} 0.045"/><geometry><cylinder radius="0.052" length="0.09"/></geometry></collision>
      <xacro:cylinder_inertia m="0.9" r="0.05" h="0.09"/>
    </link>

    <!-- Joint 4: Elbow Pitch -->
    <joint name="${prefix}_joint_4" type="revolute">
      <parent link="${prefix}_link_3"/><child link="${prefix}_link_4"/>
      <origin xyz="0 ${reflect * 0.025} 0.075"/><axis xyz="0 1 0"/>
      <limit lower="-2.25" upper="2.25" effort="40.0" velocity="2.5"/>
    </joint>
    <link name="${prefix}_link_4">
      <visual><origin xyz="0 0.059 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.045" length="0.006"/></geometry><material name="waterproof_seal"/></visual>
      <visual><origin xyz="0 -0.059 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.045" length="0.006"/></geometry><material name="waterproof_seal"/></visual>
      <visual><origin xyz="0 0 0.155"/><geometry><cylinder radius="0.042" length="0.24"/></geometry><material name="anodized_blue"/></visual>
      <visual><origin xyz="0 0 0.285"/><geometry><cylinder radius="0.044" length="0.035"/></geometry><material name="joint_dark"/></visual>
      <collision><origin xyz="0 0 0.155"/><geometry><cylinder radius="0.045" length="0.30"/></geometry></collision>
      <xacro:cylinder_inertia m="1.1" r="0.042" h="0.31"/>
    </link>

    <!-- Joint 5: Wrist Roll -->
    <joint name="${prefix}_joint_5" type="revolute">
      <parent link="${prefix}_link_4"/><child link="${prefix}_link_5"/>
      <origin xyz="0 0 0.31"/><axis xyz="0 0 1"/>
      <limit lower="-2.96" upper="2.96" effort="15.0" velocity="3.5"/>
    </joint>
    <link name="${prefix}_link_5">
      <xacro:seal_ring r="0.044"/>
      <visual><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.038" length="0.05"/></geometry><material name="robot_white"/></visual>
      <visual><origin xyz="0 0 0.055" rpy="1.5708 0 0"/><geometry><cylinder radius="0.036" length="0.088"/></geometry><material name="joint_dark"/></visual>
      <collision><origin xyz="0 0 0.035"/><geometry><cylinder radius="0.04" length="0.07"/></geometry></collision>
      <xacro:cylinder_inertia m="0.45" r="0.038" h="0.07"/>
    </link>

    <!-- Joint 6: Wrist Pitch -->
    <joint name="${prefix}_joint_6" type="revolute">
      <parent link="${prefix}_link_5"/><child link="${prefix}_link_6"/>
      <origin xyz="0 0 0.055"/><axis xyz="0 1 0"/>
      <limit lower="-2.09" upper="2.09" effort="15.0" velocity="3.5"/>
    </joint>
    <link name="${prefix}_link_6">
      <visual><origin xyz="0 0.045 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.034" length="0.005"/></geometry><material name="waterproof_seal"/></visual>
      <visual><origin xyz="0 -0.045 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.034" length="0.005"/></geometry><material name="waterproof_seal"/></visual>
      <visual><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.035" length="0.045"/></geometry><material name="robot_white"/></visual>
      <collision><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.036" length="0.05"/></geometry></collision>
      <xacro:cylinder_inertia m="0.35" r="0.035" h="0.05"/>
    </link>

    <!-- Joint 7: Wrist Flange -->
    <joint name="${prefix}_joint_7" type="revolute">
      <parent link="${prefix}_link_6"/><child link="${prefix}_link_7"/>
      <origin xyz="0 0 0.05"/><axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="15.0" velocity="4.0"/>
    </joint>
    <link name="${prefix}_link_7">
      <xacro:seal_ring r="0.036"/>
      <visual><origin xyz="0 0 0.008"/><geometry><cylinder radius="0.036" length="0.016"/></geometry><material name="brushed_metal"/></visual>
      <collision><origin xyz="0 0 0.008"/><geometry><cylinder radius="0.036" length="0.016"/></geometry></collision>
      <xacro:cylinder_inertia m="0.2" r="0.036" h="0.016"/>
    </link>

  </xacro:macro>
</robot>
